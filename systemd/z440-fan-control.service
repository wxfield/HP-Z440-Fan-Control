[Unit]
Description=HP Z440 managed fan controller
Documentation=https://github.com/wxfield/HP-Z440-Fan-Control
After=local-fs.target
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
User=root
Group=root
EnvironmentFile=-/etc/sysconfig/z440-fan-control
ExecStartPre=/usr/local/sbin/z440-hwmio write-fan 0x0198 0x7e
ExecStartPre=/usr/local/sbin/z440-hwmio write-fan 0x019a 0xb7
ExecStartPre=/usr/local/sbin/z440-hwmio write-fan 0x019b 0xb7
ExecStartPre=/usr/local/sbin/z440-hwmio write-fan 0x019c 0x7e
ExecStartPre=/usr/local/sbin/z440-hwmio write-fan 0x019d 0x7e
ExecStart=/usr/local/sbin/z440-fan-control
ExecStopPost=/usr/local/sbin/z440-hwmio write-fan 0x0198 0x7e
ExecStopPost=/usr/local/sbin/z440-hwmio write-fan 0x019a 0xb7
ExecStopPost=/usr/local/sbin/z440-hwmio write-fan 0x019b 0xb7
ExecStopPost=/usr/local/sbin/z440-hwmio write-fan 0x019c 0x7e
ExecStopPost=/usr/local/sbin/z440-hwmio write-fan 0x019d 0x7e
Restart=on-failure
RestartSec=3s
RuntimeDirectory=z440-fan-control
RuntimeDirectoryMode=0755
NoNewPrivileges=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ReadWritePaths=/run/lock /run/z440-fan-control
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=CAP_SYS_RAWIO
AmbientCapabilities=CAP_SYS_RAWIO

[Install]
WantedBy=multi-user.target
